{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "deps": "cd .. && npm ci --include=dev",
    "typecheck": "tsc",
    "seed": "tsx --env-file=.env src/seed/index.ts",
    "seed:clear": "tsx --env-file=.env src/seed/index.ts --clear"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "opentype.js": "1.3.4",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/opentype.js": "^1.3.10",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
