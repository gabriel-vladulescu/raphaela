PORT=3000
# The site's public address. Canonical links, share images, the sitemap and the RSS feed use it, so in production
# set it to the real domain (https://...).
APP_URL=http://localhost:5173
# Optional: where the server listens. Default localhost (in development Vite faces the network); production's
# start.ps1 uses 0.0.0.0 (every network interface).
# HOST=0.0.0.0
# Optional (push notifications): a contact for the push services, mailto: or https:. Default: APP_URL if it's https.
# PUSH_CONTACT=mailto:contact@example.com
# Optional: the reverse proxy whose X-Forwarded-For to trust for visitors' IPs (statistics). Default: one on this
# machine (loopback), e.g. Vite in development or nginx in front of the app.
# TRUST_PROXY=10.0.0.5
# Comma-separated; these accounts get the Owner role on sign-in
OWNER_EMAILS=you@gmail.com

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app_password
DB_NAME=raphaela_local
